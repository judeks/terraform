# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude .tfvars files that may contain secrets or environment-specific values
*.tfvars
*.tfvars.json

# Ignore override files (uncomment/negate specific ones if needed)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore temporary plan files and lock info files
*.tfplan
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc